-- KONTUR v36 room restyle: palette, materials, cove lights, rugs, plants. Generated by bundle_style.py.
do
local officeForStyle=workspace:WaitForChild("OfficeMap",30)
if officeForStyle then
local ok,err=pcall(function()
local O=workspace.OfficeMap
local C=Color3.fromRGB
local function set(p,col,mat) p.Color=col if mat then p.Material=mat end end
local function lerpv(c,a,b,t) return c:Lerp(a,t) end
local stats={}
local function count(k) stats[k]=(stats[k] or 0)+1 end
-- room accent palette (chairs/soft furniture)
local accents={
 WEST=C(34,92,104), CENTER=C(44,62,92), EAST=C(36,100,96), NW=C(70,78,96), NE=C(40,84,110),
 MEN=C(52,70,82), WOMEN=C(60,84,96), StartRoom=C(30,76,92)}
-- structure
for _,p in ipairs(O.Structure:GetDescendants()) do
 if p:IsA("BasePart") then
  if p.Name:find("PlasterUpper") then set(p,C(240,243,245)) count("upper")
  elseif p.Name:find("PaintLower") or p.Name:find("CabinetRecessWallReturn") then set(p,C(34,86,98),Enum.Material.SmoothPlastic) count("lower") end
 end
end
-- floors: deep slate carpet, keep tile-to-tile variation
for _,p in ipairs(O.Floors:GetDescendants()) do
 if p:IsA("BasePart") and p.Name=="FloorTile" and p.Transparency<1 then
  local h,s,v=p.Color:ToHSV()
  if p.Material==Enum.Material.Carpet then
   local n=(v-0.36)*1.6
   p.Color=C(58,72,88):Lerp(C(76,90,106),math.clamp(n*4+0.2,0,1)) count("carpet")
  else
   p.Material=Enum.Material.Marble p.Color=C(206,212,214):Lerp(C(232,236,238),math.clamp((v-0.58)*5,0,1)) count("hardfloor")
  end
 end
end
-- ceiling
for _,p in ipairs(O.Ceiling:GetDescendants()) do
 if p:IsA("BasePart") then
  if p.Name:find("^Tile") then set(p,C(246,248,249)) count("ctile")
  elseif p.Name:find("SeamlessGrid") then set(p,C(52,60,68),Enum.Material.Metal) count("cgrid") end
 end
end
-- architectural details
for _,p in ipairs(O.ArchitecturalDetails:GetDescendants()) do
 if p:IsA("BasePart") then
  if p.Name:find("^Skirting") then set(p,C(30,38,46),Enum.Material.SmoothPlastic) count("skirt")
  elseif p.Name:find("^DadoRail") then set(p,C(196,170,120),Enum.Material.Metal) count("dado")
  elseif p.Name:find("^Cornice") then set(p,C(250,251,252)) count("cornice")
  elseif p.Name=="BlindSlat" then set(p,C(214,220,226)) count("blind") end
 end
end
-- doors
for _,p in ipairs(O.Doors:GetDescendants()) do
 if p:IsA("BasePart") and (p.Name:find("DoorBody_")) then set(p,C(34,60,72)) count("door") end
end
-- furniture
for _,room in ipairs(O.Rooms:GetChildren()) do
 local acc=accents[room.Name] or C(40,80,96)
 for _,p in ipairs(room:GetDescendants()) do
  if p:IsA("BasePart") then
   local n=p.Name
   if n:find("^Desktop_") then set(p,C(214,186,146),Enum.Material.Wood) count("desktop")
   elseif n=="TableLeg" or n=="TableApron" or n=="CableTrayFloor" then set(p,C(236,238,240),Enum.Material.Metal) count("deskframe")
   elseif n=="ModestyPanel" then set(p,C(226,230,232)) count("modesty")
   elseif p.Material==Enum.Material.Leather and (n:find("Cushion") or n:find("Pad") or n:find("Headrest")) and p:FindFirstAncestorWhichIsA("Model") and p:FindFirstAncestorWhichIsA("Model").Name:find("Chair") then
    set(p,acc,Enum.Material.Fabric) count("chairfabric")
   elseif n:find("^BackFrame") or n:find("^ArmPad") then set(p,C(26,32,38)) count("chairframe") end
  end
 end
end
local out={} for k,v in pairs(stats) do table.insert(out,k.."="..v) end table.sort(out)
return table.concat(out," ")

end)
if not ok then warn('KonturV36 RoomRestyle_pass1.luau: '..tostring(err)) end
local ok,err=pcall(function()
local O=workspace.OfficeMap
local C=Color3.fromRGB
local stats={} local function count(k) stats[k]=(stats[k] or 0)+1 end
local accents={WEST=C(30,108,122),CENTER=C(54,82,128),EAST=C(34,118,108),NW=C(92,104,128),NE=C(40,102,138),MEN=C(64,86,100),WOMEN=C(72,100,116),StartRoom=C(30,96,116)}
for _,p in ipairs(O.Ceiling:GetDescendants()) do
 if p:IsA("BasePart") and p.Name:find("SeamlessGrid") then p.Color=C(188,198,206) count("grid") end
end
for _,p in ipairs(O.Structure:GetDescendants()) do
 if p:IsA("BasePart") and p.Name=="CabinetRecessBack" then p.Color=C(240,243,245) p.Material=Enum.Material.SmoothPlastic count("recess") end
end
for _,room in ipairs(O.Rooms:GetChildren()) do
 local acc=accents[room.Name] or C(40,100,120)
 for _,p in ipairs(room:GetDescendants()) do
  if p:IsA("BasePart") then
   local m=p:FindFirstAncestorWhichIsA("Model")
   local mn=m and m.Name or ""
   if mn:find("Chair") and p.Material==Enum.Material.Fabric then p.Material=Enum.Material.Leather p.Color=acc count("chair") end
   if mn:find("Desk") or mn:find("Table") or mn:find("Cubicle") then
    local h,s,v=p.Color:ToHSV()
    if h>0.04 and h<0.12 and s>0.3 and v>0.25 and v<0.75 and p.Material~=Enum.Material.Neon then p.Color=C(214,186,146) p.Material=Enum.Material.Wood count("brownfix") end
   end
   if mn=="NoticeBoard" and p.Name:find("^Frame") then p.Color=C(34,44,54) count("boardframe") end
  end
 end
end
local out={} for k,v in pairs(stats) do table.insert(out,k.."="..v) end table.sort(out)
return table.concat(out," ")

end)
if not ok then warn('KonturV36 RoomRestyle_pass2.luau: '..tostring(err)) end
local ok,err=pcall(function()
local O=workspace.OfficeMap
local C=Color3.fromRGB
local stats={} local function count(k) stats[k]=(stats[k] or 0)+1 end
local old=O:FindFirstChild("KonturV36") if old then old:Destroy() end
local F=Instance.new("Folder") F.Name="KonturV36" F.Parent=O
-- window infill matches new wall
for _,p in ipairs(O.V09_Joinery:GetDescendants()) do
 if p:IsA("BasePart") and p.Name:find("^WindowInfill") then p.Color=C(240,243,245) count("infill") end
end
-- cove light strips under cornices
for _,p in ipairs(O.ArchitecturalDetails:GetDescendants()) do
 if p:IsA("BasePart") and p.Name:find("^Cornice") then
  local s=Instance.new("Part") s.Name="CoveStrip" s.Anchored=true s.CanCollide=false s.CanTouch=false s.CanQuery=false s.CastShadow=false
  s.Material=Enum.Material.Neon s.Color=C(205,232,255)
  local long=math.max(p.Size.X,p.Size.Z)-0.1
  if p.Size.X>p.Size.Z then s.Size=Vector3.new(long,0.07,0.22) else s.Size=Vector3.new(0.22,0.07,long) end
  s.CFrame=CFrame.new(p.Position.X,p.Position.Y-0.26,p.Position.Z)
  s.Parent=F count("cove")
 end
end
-- rugs under tables / lounge
local rugColor={WEST=C(36,96,108),CENTER=C(52,70,104),EAST=C(40,104,98),NW=C(86,96,120),NE=C(44,92,122),MEN=C(60,80,94),WOMEN=C(70,92,108),StartRoom=C(34,88,108)}
for _,room in ipairs(O.Rooms:GetChildren()) do
 for _,m in ipairs(room:GetChildren()) do
  if m:IsA("Model") and (m.Name:find("CoffeeTable") or m.Name:find("MeetingTable") or m.Name:find("ExecutiveDesk")) then
   local cf,sz=m:GetBoundingBox()
   local pad=m.Name:find("Coffee") and 3.2 or 4.2
   local r=Instance.new("Part") r.Name="Rug" r.Anchored=true r.CanCollide=false r.CanQuery=false r.CastShadow=false
   r.Material=Enum.Material.Fabric r.Color=rugColor[room.Name] or C(50,80,100)
   r.Size=Vector3.new(sz.X+pad,0.04,sz.Z+pad)
   r.CFrame=CFrame.new(cf.X,0.12,cf.Z)*(cf-cf.Position):Inverse()*CFrame.Angles(0,select(2,cf:ToEulerAnglesYXZ()),0)
   r.Parent=F count("rug")
   local b=r:Clone() b.Name="RugBorder" b.Size=Vector3.new(r.Size.X-0.8,0.05,r.Size.Z-0.8) b.Color=r.Color:Lerp(C(235,238,240),0.22) b.CFrame=r.CFrame+Vector3.new(0,0.002,0) b.Parent=F
  end
 end
end
local out={} for k,v in pairs(stats) do table.insert(out,k.."="..v) end table.sort(out)
return table.concat(out," ")

end)
if not ok then warn('KonturV36 RoomRestyle_pass3.luau: '..tostring(err)) end
end
end
