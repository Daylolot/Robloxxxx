-- Generated by blender/plants_v36.py. Vertices i16*0.001 studs, normals i8, colours 5-bit sRGB, triangles u16 (base64).
local PLANT_DATA={
  fig={nv=1581,nt=2318,center=Vector3.new(-0.0383,2.9868,0.0556),
    v="",
    n="",
    c="",
    t="",
  },
  lily={nv=1537,nt=2270,center=Vector3.new(0.0252,2.3444,-0.0247),
    v="",
    n="",
